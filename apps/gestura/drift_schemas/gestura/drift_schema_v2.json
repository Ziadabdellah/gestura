    {
      "name": "progress",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"progress\" (\"lesson_id\" TEXT NOT NULL PRIMARY KEY, \"best_score\" INTEGER NOT NULL CHECK (best_score BETWEEN 0 AND 100), \"completed_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "review_cards",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"review_cards\" (\"sign_id\" TEXT NOT NULL PRIMARY KEY, \"repetitions\" INTEGER NOT NULL CHECK (repetitions >= 0), \"interval_days\" INTEGER NOT NULL CHECK (interval_days >= 0), \"ease\" REAL NOT NULL CHECK (ease >= 1.3), \"due_at\" TEXT NOT NULL, \"lapses\" INTEGER NOT NULL DEFAULT 0 CHECK (lapses >= 0), \"updated_at\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "collections",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"collections\" (\"id\" TEXT NOT NULL PRIMARY KEY, \"name\" TEXT NOT NULL CHECK (length(name) BETWEEN 1 AND 60), \"created_at\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "collection_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"collection_items\" (\"collection_id\" TEXT NOT NULL REFERENCES collections(id)ON DELETE CASCADE, \"sign_id\" TEXT NOT NULL, \"added_at\" TEXT NOT NULL, PRIMARY KEY(collection_id, sign_id));"
        }
      ]
    },
    {
      "name": "daily_activity",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"daily_activity\" (\"day\" TEXT NOT NULL PRIMARY KEY, \"lessons\" INTEGER NOT NULL DEFAULT 0 CHECK (lessons >= 0), \"reviews\" INTEGER NOT NULL DEFAULT 0 CHECK (reviews >= 0), \"seconds\" INTEGER NOT NULL DEFAULT 0 CHECK (seconds >= 0));"
        }
      ]
    }
